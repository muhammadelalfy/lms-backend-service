APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Schools (SaaS). Every school has its own database and its own address,
# https://<school>.<TENANT_BASE_DOMAIN>. The addresses in CENTRAL_DOMAINS are
# the platform's own (operator API, LiveKit webhook, Google/Zoom redirect), not a school's.
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_BASE_DOMAIN=mudarisy.test
# Development only: the school served at the plain address http://127.0.0.1:8000.
# DEFAULT_SCHOOL=demo
# Token for the operator API at /api/central/* (leave empty to switch the API off).
CENTRAL_API_TOKEN=
# A school's database is called <prefix><school><suffix>, e.g. tenantalnour.sqlite.
TENANCY_DB_PREFIX=tenant
TENANCY_DB_SUFFIX=.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Handwriting reading for homework photos (Claude vision).
ANTHROPIC_API_KEY=
ANTHROPIC_OCR_MODEL=claude-opus-5-5

# Online payments through Fawry (reference number) and Vodafone Cash (wallet).
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_WEBHOOK_URL=
FAWRY_EXPIRY_HOURS=48

VITE_APP_NAME="${APP_NAME}"

# SMS through a local aggregator's HTTP API (see config/services.php) and the
# WhatsApp Business Cloud API. Without them those channels are skipped and
# people still get every notice in the app inbox and by push.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=Mudarisy
SMS_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_DEFAULT=school_update
# Optional daily caps on paid sends, school-wide.
NOTIFY_WHATSAPP_DAILY_CAP=
NOTIFY_SMS_DAILY_CAP=

# Chat WebSocket server (Laravel Reverb, Pusher protocol). Set BROADCAST_CONNECTION=reverb
# and run `php artisan reverb:start`; until then the app falls back to fetching
# new messages every few seconds.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# AI service (lms-ai-service): exam materials. Empty URL = AI features report "unavailable".
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
# Exam generation: long calls (one batch of up to 10 questions), a job reserves estimate x margin units.
AI_GENERATE_TIMEOUT=180
AI_UNITS_RESERVE_MARGIN=1.2
# Plans whose `ai_exams` flag turns from "soon" to on (e.g. t3,t4). Set ONLY after the shared AI-service
# budgets (S63) are deployed and the evaluation gate (S73) passed; empty = every plan stays "soon".
AI_EXAMS_LIVE_TIERS=

# Built-in voice and video: a self-hosted LiveKit server (see deploy/livekit.yaml).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: create Google Meet / Zoom meetings from the app (OAuth clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# Public landing page (central domain home). Empty store links show "soon".
LANDING_NAME=Mudarisy
LANDING_ANDROID_URL=
LANDING_IOS_URL=
LANDING_WEB_URL=
LANDING_CONTACT_EMAIL=
