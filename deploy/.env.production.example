# Copy to deploy/.env.production and fill in. Never commit the filled-in file.
APP_NAME=Mudarisy
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm <api image> php artisan key:generate --show
APP_KEY=
APP_URL=http://api.mudarisy.localhost
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Tenancy: <school>.TENANT_BASE_DOMAIN is a school; CENTRAL_DOMAINS is the operator side.
CENTRAL_DOMAINS=api.mudarisy.localhost,127.0.0.1
TENANT_BASE_DOMAIN=mudarisy.localhost
# Long random string (openssl rand -hex 32).
CENTRAL_API_TOKEN=
TENANCY_DB_PREFIX=tenant
TENANCY_DB_SUFFIX=.sqlite
TRUSTED_PROXIES=*

# SQLite shared by several replicas: wait for locks, WAL, take write locks up front.
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal
DB_TRANSACTION_MODE=IMMEDIATE

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Integrations (Fawry, SMS, WhatsApp, LiveKit, Google/Zoom, Anthropic): see ../.env.example.
# AI exams: AI_SERVICE_URL (the lms-ai-service address, internal) and AI_SERVICE_TOKEN (its bearer
# token). Empty URL = materials report "assistant unavailable"; nothing else depends on it.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
